ANTHROPIC_API_KEY=
DATABASE_URL=sqlite:///./demandas.db

# Triagem (fase 2) - qual motor usar: claude_code (padrao, usa a assinatura
# via CLI, sem chave de API) ou api (API do Claude direto).
TRIAGEM_MOTOR=claude_code

# --- motor claude_code ---
# Requer `claude` autenticado (claude login ou claude setup-token).
CLAUDE_CODE_CAMINHO=claude
CLAUDE_CODE_MODELO=haiku
CLAUDE_CODE_TIMEOUT_SEGUNDOS=60

# --- motor api --- (so usado se TRIAGEM_MOTOR=api; modelo configuravel,
# o padrao e o menor disponivel)
CLAUDE_TRIAGEM_MODELO=claude-haiku-5-5
CLAUDE_TRIAGEM_MAX_TOKENS=400
CLAUDE_TRIAGEM_PRECO_ENTRADA_USD_MI=1.0
CLAUDE_TRIAGEM_PRECO_SAIDA_USD_MI=5.0
